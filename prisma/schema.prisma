generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Driver {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  driverNumber Int       @unique @map("driver_number")
  driverName   String    @map("driver_name") @db.VarChar(255)
  status       String    @default("active") @db.VarChar(20)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  payments     Payment[]

  @@index([driverNumber])
  @@index([driverName])
  @@index([status])
  @@map("drivers")
}

model Payment {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  driverId    String   @map("driver_id") @db.Uuid
  amount      Decimal  @db.Decimal(12, 2)
  paymentDate DateTime @default(now()) @map("payment_date") @db.Timestamptz(6)
  status      String   @default("active") @db.VarChar(20)
  notes       String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Restrict)

  @@index([driverId])
  @@index([paymentDate])
  @@index([status])
  @@map("payments")
}
